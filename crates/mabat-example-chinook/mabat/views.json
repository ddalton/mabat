        {
          "name": "manager",
          "view": "ManagerChain",
          "parent": 0,
          "link": {
            "kind": "to_one",
            "ref_alias": "$ref.manager"
          },
          "table": "employee",
          "key_column": "employee_id",
          "key_alias": "employee_id",
          "sql": "WITH RECURSIVE \"$tree\" AS (\nSELECT t0.\"employee_id\" AS \"k\", t0.\"reports_to\" AS \"n\", ',' || t0.\"employee_id\" || ',' AS \"path\", 1 AS \"depth\" FROM \"employee\" AS t0 WHERE t0.\"employee_id\" IN (:keys)\nUNION ALL\nSELECT t0.\"employee_id\", t0.\"reports_to\", r.\"path\" || t0.\"employee_id\" || ',', r.\"depth\" + 1 FROM \"employee\" AS t0 JOIN \"$tree\" AS r ON t0.\"employee_id\" = r.\"n\" WHERE instr(r.\"path\", ',' || t0.\"employee_id\" || ',') = 0\n)\nSELECT t0.\"employee_id\" AS \"employee_id\",\n       t0.\"first_name\" AS \"first_name\",\n       t0.\"last_name\" AS \"last_name\",\n       t0.\"title\" AS \"title\",\n       t0.\"reports_to\" AS \"$ref.manager\"\nFROM (SELECT DISTINCT \"k\" FROM \"$tree\") AS r JOIN \"employee\" AS t0 ON t0.\"employee_id\" = r.\"k\"\nORDER BY t0.\"employee_id\"",
          "columns": [
            {
              "alias": "employee_id",
              "role": "field",
              "column": "employee_id",
              "type": {
                "rust": "i32",
                "sql": "INTEGER",
                "accepts": [
                  "INTEGER"
                ]
